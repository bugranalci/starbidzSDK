DESCRIPTION >
    Statistics for publisher dashboard

NODE publisher_stats_node
SQL >
    %
    SELECT
        toDate(timestamp) as date,
        publisher_id,
        app_key,
        countIf(event_type = 'BID_REQUEST') as requests,
        countIf(event_type = 'IMPRESSION') as impressions,
        countIf(event_type = 'CLICK') as clicks,
        sumIf(net_price, event_type = 'IMPRESSION') as net_revenue,
        sumIf(win_price, event_type = 'IMPRESSION') as gross_revenue,
        if(requests > 0, impressions / requests * 100, 0) as fill_rate,
        if(impressions > 0, clicks / impressions * 100, 0) as ctr,
        if(impressions > 0, net_revenue / impressions * 1000, 0) as ecpm
    FROM ad_events
    WHERE toDate(timestamp) >= {{Date(start_date, '2025-01-01', description="Start date (YYYY-MM-DD)")}}
      AND toDate(timestamp) <= {{Date(end_date, '2025-12-31', description="End date (YYYY-MM-DD)")}}
      AND publisher_id = {{String(publisher_id, description="Publisher ID (required)")}}
      {% if defined(app_key) and app_key != '' %}
      AND app_key = {{String(app_key)}}
      {% end %}
    GROUP BY date, publisher_id, app_key
    ORDER BY date DESC

TYPE endpoint
