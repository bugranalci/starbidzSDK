DESCRIPTION >
    Real-time metrics for last hour

NODE realtime_metrics_node
SQL >
    %
    SELECT
        countIf(event_type = 'BID_REQUEST') / 60 as requests_per_minute,
        if(countIf(event_type = 'BID_REQUEST') > 0,
           countIf(event_type = 'BID_RESPONSE') / countIf(event_type = 'BID_REQUEST') * 100,
           0) as fill_rate,
        avgIf(latency_ms, event_type = 'BID_RESPONSE' AND latency_ms > 0) as avg_latency_ms,
        uniqIf(demand_source, event_type = 'BID_RESPONSE' AND demand_source IS NOT NULL) as active_demand_sources
    FROM ad_events
    WHERE timestamp >= now() - INTERVAL 1 HOUR
      {% if defined(app_key) and app_key != '' %}
      AND app_key = {{String(app_key)}}
      {% end %}

TYPE endpoint
