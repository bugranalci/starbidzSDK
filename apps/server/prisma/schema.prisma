// This schema mirrors the dashboard schema for database access
// Both apps share the same database

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== APP & PUBLISHER ====================

model App {
  id          String   @id @default(cuid())
  publisherId String
  name        String
  bundleId    String
  platform    Platform
  appKey      String   @unique @default(cuid())
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum Platform {
  ANDROID
  IOS
  BOTH
}

enum AdFormat {
  BANNER
  INTERSTITIAL
  REWARDED
}

// ==================== DEMAND SOURCES ====================

model DemandSource {
  id        String     @id @default(cuid())
  type      DemandType
  name      String
  isActive  Boolean    @default(true)
  priority  Int        @default(1)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  // Polymorphic relations
  gamConfig   GamConfig?
  unityConfig UnityConfig?
  fyberConfig FyberConfig?
  ortbConfig  OrtbConfig?
  adUnits     DemandAdUnit[]
}

enum DemandType {
  GAM
  UNITY
  FYBER
  ORTB
}

// GAM/MCM Configuration - Client-side, sadece ad unit path gerekli
model GamConfig {
  id             String       @id @default(cuid())
  demandSourceId String       @unique
  demandSource   DemandSource @relation(fields: [demandSourceId], references: [id], onDelete: Cascade)
  networkCode    String?      // Opsiyonel - sadece referans için
}

// Unity Ads Configuration - Client-side
model UnityConfig {
  id             String       @id @default(cuid())
  demandSourceId String       @unique
  demandSource   DemandSource @relation(fields: [demandSourceId], references: [id], onDelete: Cascade)
  gameIdAndroid  String       // Unity Game ID for Android
  gameIdIos      String       // Unity Game ID for iOS
}

// Fyber Configuration - Client-side
model FyberConfig {
  id             String       @id @default(cuid())
  demandSourceId String       @unique
  demandSource   DemandSource @relation(fields: [demandSourceId], references: [id], onDelete: Cascade)
  appIdAndroid   String       // Fyber App ID for Android
  appIdIos       String       // Fyber App ID for iOS
}

// OpenRTB DSP Configuration (Server-side bidding)
model OrtbConfig {
  id             String       @id @default(cuid())
  demandSourceId String       @unique
  demandSource   DemandSource @relation(fields: [demandSourceId], references: [id], onDelete: Cascade)
  endpoint       String
  seatId         String?
  authHeader     String?
  authValue      String?      // Encrypted
  timeout        Int          @default(200)

  // Format-based configuration
  bannerEnabled       Boolean @default(true)
  bannerFloor         Float   @default(1.0)
  interstitialEnabled Boolean @default(true)
  interstitialFloor   Float   @default(5.0)
  rewardedEnabled     Boolean @default(true)
  rewardedFloor       Float   @default(8.0)
}

// Individual ad units for GAM/Unity/Fyber (TopOn style)
model DemandAdUnit {
  id             String       @id @default(cuid())
  demandSourceId String
  demandSource   DemandSource @relation(fields: [demandSourceId], references: [id], onDelete: Cascade)

  name       String       // Ad Source Name (e.g., "REW-12$-AR-Cashbox")
  externalId String       // GAM ad unit path, Unity placement ID, Fyber spot ID
  format     AdFormat
  bidFloor   Float        // Price($) - floor price for this ad unit
  platform   Platform     @default(BOTH)

  // Banner specific
  width  Int?
  height Int?

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([demandSourceId, externalId, platform])
}
